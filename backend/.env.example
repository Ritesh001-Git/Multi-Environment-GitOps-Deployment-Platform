APP_NAME=GitOps Platform API
APP_VERSION=1.0.0
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET

DATABASE_URL=sqlite+aiosqlite:///./gitops-local-test.db

JENKINS_URL=http://localhost:8080
JENKINS_USER=gitops-api
JENKINS_TOKEN=REPLACE_WITH_JENKINS_API_TOKEN
JENKINS_JOB_NAME=gitops-deploy
JENKINS_REQUEST_TIMEOUT_SECONDS=10
JENKINS_QUEUE_TIMEOUT_SECONDS=120
JENKINS_BUILD_TIMEOUT_SECONDS=1800
JENKINS_MAX_POLL_ERRORS=6

DOCKERHUB_USER=REPLACE_WITH_DOCKERHUB_USER

KUBE_MODE=kubeconfig
KUBE_NAMESPACE=gitops
KUBE_DEPLOYMENT_NAME=gitops-app
KUBE_REQUEST_TIMEOUT_SECONDS=10
K3S_DEPLOY_HOST=127.0.0.1
POLL_INTERVAL_SECONDS=5
