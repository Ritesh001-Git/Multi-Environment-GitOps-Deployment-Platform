  "panels": [
    {"type":"stat","title":"Backend Up","id":1,"gridPos":{"h":4,"w":4,"x":0,"y":0},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"max(up{job=\"fastapi-backend\"})","refId":"A"}]},
    {"type":"stat","title":"Deployments (24h)","id":2,"gridPos":{"h":4,"w":5,"x":4,"y":0},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(increase(gitops_deployments_total[24h]))","refId":"A"}]},
    {"type":"stat","title":"Deployment Success Rate (24h)","id":3,"gridPos":{"h":4,"w":5,"x":9,"y":0},"fieldConfig":{"defaults":{"unit":"percentunit"}},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(increase(gitops_deployments_success_total[24h])) / clamp_min(sum(increase(gitops_deployments_success_total[24h])) + sum(increase(gitops_deployments_failed_total[24h])), 1)","refId":"A"}]},
    {"type":"stat","title":"Running Pods","id":4,"gridPos":{"h":4,"w":5,"x":14,"y":0},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(kube_pod_status_phase{namespace=\"gitops\",phase=\"Running\"})","refId":"A"}]},
    {"type":"stat","title":"Services","id":5,"gridPos":{"h":4,"w":5,"x":19,"y":0},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"count(kube_service_info{namespace=\"gitops\"})","refId":"A"}]},
    {"type":"timeseries","title":"Node CPU","id":6,"gridPos":{"h":8,"w":8,"x":0,"y":4},"fieldConfig":{"defaults":{"unit":"percent"}},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"100 - avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100","legendFormat":"{{instance}}","refId":"A"}]},
    {"type":"timeseries","title":"Node Memory","id":7,"gridPos":{"h":8,"w":8,"x":8,"y":4},"fieldConfig":{"defaults":{"unit":"percent"}},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100","legendFormat":"{{instance}}","refId":"A"}]},
    {"type":"timeseries","title":"Container CPU","id":8,"gridPos":{"h":8,"w":8,"x":16,"y":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum by(name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m]))","legendFormat":"{{name}}","refId":"A"}]},
    {"type":"timeseries","title":"Container Memory","id":9,"gridPos":{"h":8,"w":8,"x":0,"y":12},"fieldConfig":{"defaults":{"unit":"bytes"}},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum by(name) (container_memory_working_set_bytes{name!=\"\"})","legendFormat":"{{name}}","refId":"A"}]},
    {"type":"timeseries","title":"Backend Request Rate","id":10,"gridPos":{"h":8,"w":8,"x":8,"y":12},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(rate(http_requests_total[5m])) by (status)","legendFormat":"{{status}}","refId":"A"}]},
    {"type":"timeseries","title":"Deployment Duration p95","id":11,"gridPos":{"h":8,"w":8,"x":16,"y":12},"fieldConfig":{"defaults":{"unit":"s"}},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"histogram_quantile(0.95, sum(rate(gitops_deployment_duration_seconds_bucket[1h])) by (le, status))","legendFormat":"{{status}}","refId":"A"}]}
